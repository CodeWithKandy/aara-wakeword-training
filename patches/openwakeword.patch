@@ -35,6 +35,41 @@ import torchaudio
 import mutagen
 import acoustics
 
+# --- Patch: bypass torchcodec for audio I/O (Windows/cu130 compatibility) ---
+# torchaudio now requires torchcodec for load()/info(), which has documented,
+# unresolved loading failures on Windows with recent CUDA builds. soundfile
+# has already proven reliable throughout this project, so we route through
+# it instead and reconstruct torchaudio's expected return types.
+import soundfile as _sf
+from collections import namedtuple as _namedtuple
+
+_AudioMetaData = _namedtuple(
+    "AudioMetaData", ["sample_rate", "num_frames", "num_channels", "bits_per_sample", "encoding"]
+)
+
+
+def _patched_load(filepath, *args, **kwargs):
+    data, sr = _sf.read(str(filepath), dtype="float32", always_2d=True)
+    return torch.from_numpy(data.T), sr
+
+
+def _patched_info(filepath, *args, **kwargs):
+    try:
+        info = _sf.info(str(filepath))
+    except Exception as e:
+        raise RuntimeError(str(e))
+    return _AudioMetaData(
+        sample_rate=info.samplerate,
+        num_frames=info.frames,
+        num_channels=info.channels,
+        bits_per_sample=16,
+        encoding="PCM_S",
+    )
+
+
+torchaudio.load = _patched_load
+torchaudio.info = _patched_info
+# --- End patch ---
 
 # Load audio clips and structure into clips of the same length
 def stack_clips(audio_data, clip_size=16000*2):
@@ -886,8 +921,17 @@ def trim_mmap(mmap_path):
             mmap_file2.flush()
 
     # Remove old mmaped file
+    # Windows holds a lock on memory-mapped files until the handle is released;
+    # explicitly drop the reference and force garbage collection before deleting.
+    del mmap_file1
+    import gc
+    gc.collect()
     os.remove(mmap_path)
 
+    # Release the new memmap's handle too, before renaming it (same Windows constraint)
+    del mmap_file2
+    gc.collect()
+
     # Rename new mmap file to match original
     os.rename(output_file2, mmap_path)
 
